# Linux -> Windows x64 with Clang, lld and an xwin MSVC/Windows SDK tree.
# export TCB_WINDOWS_SDK=/absolute/path/to/xwin-splat
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_LINKER lld-link)
set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
# lld merges a raw .res with its generated embedded manifest.
set(CMAKE_RC_FLAGS_INIT "-O res")
set(TCB_WINDOWS_SDK "$ENV{TCB_WINDOWS_SDK}")
if(NOT EXISTS "${TCB_WINDOWS_SDK}/crt/include/vector")
  message(FATAL_ERROR "TCB_WINDOWS_SDK must contain an xwin CRT/SDK tree")
endif()
find_program(TCB_PYTHON NAMES python3 REQUIRED)
set(_tcb_overlay "${TCB_WINDOWS_SDK}/tcb-overlay.json")
if(NOT EXISTS "${_tcb_overlay}")
  execute_process(COMMAND "${TCB_PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/make-sdk-overlay.py" "${TCB_WINDOWS_SDK}" "${_tcb_overlay}" COMMAND_ERROR_IS_FATAL ANY)
endif()
set(_tcb_includes "-ivfsoverlay ${_tcb_overlay} -idirafter ${TCB_WINDOWS_SDK}/crt/include -idirafter ${TCB_WINDOWS_SDK}/sdk/include/ucrt -idirafter ${TCB_WINDOWS_SDK}/sdk/include/shared -idirafter ${TCB_WINDOWS_SDK}/sdk/include/um -idirafter ${TCB_WINDOWS_SDK}/sdk/include/winrt")
set(CMAKE_C_FLAGS_INIT "${_tcb_includes} -D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH")
set(CMAKE_CXX_FLAGS_INIT "${_tcb_includes} -D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -L${TCB_WINDOWS_SDK}/crt/lib/x86_64 -L${TCB_WINDOWS_SDK}/sdk/lib/ucrt/x86_64 -L${TCB_WINDOWS_SDK}/sdk/lib/um/x86_64")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
